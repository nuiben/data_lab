# ── AWS ───────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_PROFILE=default
# Or use explicit keys (not recommended; prefer profiles or IAM roles):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── S3 ────────────────────────────────────────────────────
DATA_LAB_S3_BUCKET=my-data-lab-bucket

# ── Snowflake ─────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=myaccount.us-east-1
SNOWFLAKE_USER=myuser
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=DATA_LAB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=SYSADMIN

# ── PostgreSQL (local Docker) ─────────────────────────────
POSTGRES_USER=data_lab
POSTGRES_PASSWORD=changeme
POSTGRES_DB=data_lab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── pgAdmin ───────────────────────────────────────────────
PGADMIN_EMAIL=admin@data-lab.local
PGADMIN_PASSWORD=changeme
PGADMIN_PORT=5050

# ── Local dev ─────────────────────────────────────────────
LOG_LEVEL=INFO
