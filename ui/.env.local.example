# Copy to .env.local and fill in real values.
# AWS credentials are picked up from the credential chain (profile, env vars, instance role).
AWS_REGION=us-east-1
AWS_PROFILE=default

DATA_LAB_S3_BUCKET=my-data-lab-bucket

# Full ARN — get this after running: just aws-sfn-deploy
SFN_STATE_MACHINE_ARN=arn:aws:states:us-east-1:123456789012:stateMachine:data-lab-pipeline
